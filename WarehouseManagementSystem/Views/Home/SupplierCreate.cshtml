@model WarehouseManagementSystem.Models.Supplier
@{
    ViewData["Title"] = "Yeni Tedarikçi";
}
<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body">
                <h3 class="fw-bold mb-4">
                    <i class="bi bi-plus-circle text-primary"></i> Yeni Tedarikçi
                </h3>
                <form asp-action="SupplierCreate" method="post">
                    <div class="mb-3">
                        <label asp-for="SupplierName" class="form-label"></label>
                        <input asp-for="SupplierName" class="form-control" placeholder="Tedarikçi Adı" />
                        <span asp-validation-for="SupplierName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ContactInfo" class="form-label"></label>
                        <input asp-for="ContactInfo" class="form-control" placeholder="İletişim Bilgisi" />
                        <span asp-validation-for="ContactInfo" class="text-danger"></span>
                    </div>
                    <div class="mt-4 d-flex justify-content-between">
                        <a href="/Home/Suppliers" class="btn btn-outline-secondary">Vazgeç</a>
                        <button type="submit" class="btn btn-primary">Kaydet <i class="bi bi-check-circle"></i></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
