@model IEnumerable<WarehouseManagementSystem.Models.Product>
@{
    ViewData["Title"] = "Ürünler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-box-seam text-success"></i> Ürünler
    </h2>
    <a href="/Home/ProductCreate" class="btn btn-primary rounded-pill shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Yeni Ürün Ekle
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-warning text-center">
        <i class="bi bi-exclamation-circle"></i> Henüz ürün eklenmemiş!
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card shadow-sm hover-shadow h-100 border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-box-seam display-4 text-success mb-2"></i>
                        <h5 class="card-title">@item.ProductName</h5>
                        <p class="text-muted mb-1 small">@item.Description</p>
                        <span class="badge bg-secondary mb-2">Stok: @item.QuantityInStock</span>
                        <div class="fw-bold mb-3">@item.Price ₺</div>
                        <a href="/Home/ProductEdit/@item.ProductID" class="btn btn-outline-info btn-sm me-1">
                            <i class="bi bi-pencil"></i> Düzenle
                        </a>

                        <!-- Silme butonu: sadece modal açar -->
                        <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.ProductID">
                            <i class="bi bi-trash"></i> Sil
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Modal’lar sayfa sonunda toplanıyor -->
    @foreach (var item in Model)
    {
        <div class="modal fade" id="deleteModal-@item.ProductID" tabindex="-1" aria-labelledby="deleteModalLabel-@item.ProductID" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteModalLabel-@item.ProductID">Silme Onayı</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>
                    <div class="modal-body">
                        "@item.ProductName" adlı ürünü silmek istediğinize emin misiniz?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>

                        <form asp-action="ProductDelete" asp-route-id="@item.ProductID" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-danger">Sil</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}


