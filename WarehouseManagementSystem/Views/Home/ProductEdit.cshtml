@model WarehouseManagementSystem.Models.Product
@{
    ViewData["Title"] = "Ürün Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body">
                <h3 class="fw-bold mb-4">
                    <i class="bi bi-pencil text-info"></i> Ürün Düzenle
                </h3>
                <form asp-action="ProductEdit" method="post">
                    <input type="hidden" asp-for="ProductID" />

                    <div class="mb-3">
                        <label asp-for="ProductName" class="form-label"></label>
                        <input asp-for="ProductName" class="form-control" placeholder="Ürün Adı" />
                        <span asp-validation-for="ProductName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="2" placeholder="Açıklama"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="QuantityInStock" class="form-label"></label>
                        <input asp-for="QuantityInStock" class="form-control" type="number" min="0" />
                        <span asp-validation-for="QuantityInStock" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Price" class="form-label"></label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryID" class="form-label"></label>
                        <select asp-for="CategoryID" class="form-select" asp-items="ViewBag.Categories">
                            <option value="">Kategori Seçiniz</option>
                        </select>
                        <span asp-validation-for="CategoryID" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SupplierID" class="form-label"></label>
                        <select asp-for="SupplierID" class="form-select" asp-items="ViewBag.Suppliers">
                            <option value="">Tedarikçi Seçiniz</option>
                        </select>
                        <span asp-validation-for="SupplierID" class="text-danger"></span>
                    </div>

                    <div class="mt-4 d-flex justify-content-between">
                        <a href="/Home/Products" class="btn btn-outline-secondary">Vazgeç</a>
                        <button type="submit" class="btn btn-info text-white">
                            Güncelle <i class="bi bi-check-circle"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
