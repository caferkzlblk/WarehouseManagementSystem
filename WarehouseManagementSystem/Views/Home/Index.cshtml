@{
    ViewData["Title"] = "Ana Sayfa";
    var userName = ViewBag.UserName as string ?? "Kullanıcı";
}

<div class="row justify-content-center mb-5">
    <div class="col-lg-8 text-center">
        <h1 class="fw-bold mb-3 display-5">
            <i class="bi bi-box-seam text-primary" style="font-size:48px;vertical-align:middle;"></i>
            Hoşgeldiniz, @userName!
        </h1>
        <p class="lead text-muted">
            <b>Warehouse Management System</b> ile tüm sipariş, stok, tedarikçi ve kullanıcı işlemlerini tek bir panelden yönetebilirsiniz.
        </p>
    </div>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-12 col-sm-6 col-md-4">
        <a href="/Home/Orders" class="text-decoration-none">
            <div class="card shadow-sm h-100 hover-shadow">
                <div class="card-body text-center">
                    <i class="bi bi-basket display-3 text-primary"></i>
                    <h5 class="card-title mt-3">Siparişler</h5>
                    <p class="card-text text-muted">Siparişleri incele, düzenle veya yeni sipariş oluştur.</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-md-4">
        <a href="/Home/Products" class="text-decoration-none">
            <div class="card shadow-sm h-100 hover-shadow">
                <div class="card-body text-center">
                    <i class="bi bi-box-seam display-3 text-success"></i>
                    <h5 class="card-title mt-3">Ürünler</h5>
                    <p class="card-text text-muted">Tüm ürünleri ve stok bilgilerini görüntüle.</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-md-4">
        <a href="/Home/Suppliers" class="text-decoration-none">
            <div class="card shadow-sm h-100 hover-shadow">
                <div class="card-body text-center">
                    <i class="bi bi-truck display-3 text-warning"></i>
                    <h5 class="card-title mt-3">Tedarikçiler</h5>
                    <p class="card-text text-muted">Tedarikçi bilgilerini kolayca yönet.</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-md-4">
        <a href="/Home/Users" class="text-decoration-none">
            <div class="card shadow-sm h-100 hover-shadow">
                <div class="card-body text-center">
                    <i class="bi bi-person display-3 text-info"></i>
                    <h5 class="card-title mt-3">Kullanıcılar</h5>
                    <p class="card-text text-muted">Kullanıcı hesaplarını ve yetkilerini yönet.</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-md-4">
        <a href="/Home/Categories" class="text-decoration-none">
            <div class="card shadow-sm h-100 hover-shadow">
                <div class="card-body text-center">
                    <i class="bi bi-tags display-3 text-secondary"></i>
                    <h5 class="card-title mt-3">Kategoriler</h5>
                    <p class="card-text text-muted">Ürün kategorilerini görüntüle veya düzenle.</p>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row mt-5">
    <div class="col-12 text-center">
        <small class="text-muted">Son giriş: <b>@DateTime.Now.ToString("dd MMMM yyyy")</b> &mdash; Geliştirici: <span class="text-primary">Cafer Kızılbulak</span></small>
    </div>
</div>
