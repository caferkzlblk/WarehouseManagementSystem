@model WarehouseManagementSystem.Models.OrderFilterViewModel
@{
    ViewData["Title"] = "Siparişler";
}
@if (TempData["OrderStatusMessage"] != null)
{
    <div class="alert alert-info my-3">@TempData["OrderStatusMessage"]</div>
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-basket text-primary"></i> Siparişler
    </h2>
    <div>
        <form action="/Home/ExportOrdersToExcel" method="get" class="d-inline">
            <input type="hidden" name="statusID" value="@Model.StatusID" />
            <input type="hidden" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
            <button type="submit" class="btn btn-outline-success">
                <i class="bi bi-file-earmark-excel"></i> Excele Aktar
            </button>
        </form>






        <a href="/Home/OrderCreate" class="btn btn-success ms-2 rounded-pill shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Yeni Sipariş Oluştur
        </a>
    </div>
</div>
<div class="card mb-3 p-3 shadow-sm">
    <h5 class="mb-3">Sipariş Numarası ile Durum Güncelle</h5>
    <form asp-action="UpdateOrderStatus" asp-controller="Home" method="post" class="row g-2 align-items-end">
        <div class="col-12 col-md-8">
            <label for="OrderNumberValue" class="form-label">Sipariş Numarası</label>
            <input type="text" name="orderNumberValue" id="OrderNumberValue" class="form-control" placeholder="Sipariş No girin..." required />
            <input type="hidden" name="orderID" value="" /> <!-- Controller otomatik bulacak, gerekirse doldur -->
        </div>
        <div class="col-12 col-md-4">
            <button type="submit" class="btn btn-primary w-100 mt-4">Durumu Güncelle</button>
        </div>
    </form>
    <small class="text-muted">Sipariş numarasını girip güncelle butonuna basınca sistem siparişi sıradaki duruma geçirir.</small>
</div>


<!-- FİLTRE PANELİ -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
        <form asp-action="Orders" asp-controller="Home" method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Durum</label>
                <select name="statusID" class="form-select">
                    <option value="">Tümü</option>
                    @foreach (var status in Model.Status ?? Enumerable.Empty<WarehouseManagementSystem.Models.Statuses>())
                    {
                        if (Model.StatusID == status.StatusID)
                        {
                            <option value="@status.StatusID" selected>@status.StatusName</option>
                        }
                        else
                        {
                            <option value="@status.StatusID">@status.StatusName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Başlangıç Tarihi</label>
                <input name="startDate" type="date" class="form-control" value="@(Model.StartDate?.ToString("yyyy-MM-dd") ?? "")" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Bitiş Tarihi</label>
                <input name="endDate" type="date" class="form-control" value="@(Model.EndDate?.ToString("yyyy-MM-dd") ?? "")" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Filtrele</button>
            </div>
        </form>
    </div>
</div>

<!-- SİPARİŞ LİSTESİ -->
@if (Model.Orders == null || !Model.Orders.Any())
{
    <div class="alert alert-warning text-center">
        <i class="bi bi-exclamation-circle"></i> Henüz sipariş yok!
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm rounded">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Sipariş No</th>
                    <th>Tarih</th>
                    <th>Müşteri</th>
                    <th>Durum</th>
                    <th>Kargo</th>
                    <th>Tutar</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Orders)
                {
                    <tr>
                        <td><i class="bi bi-basket text-primary"></i></td>
                        <td>@item.OrderNumberValue</td>
                        <td>@item.OrderDate.ToString("dd.MM.yyyy")</td>
                        <td>@item.CustomerID</td>
                        <td>
                            <span class="badge bg-@(item.StatusID == 1 ? "secondary" : item.StatusID == 2 ? "primary" : item.StatusID == 3 ? "success" : "dark")">
                                @item.Status?.StatusName
                            </span>
                        </td>
                        <td>@item.ShippingCompanyID</td>
                        <td>@string.Format("{0:N2} ₺", item.TotalCost)</td>
                        <td>
                            <a href="/Home/OrderDetailsDetails/@item.OrderID" class="btn btn-outline-info btn-sm me-1">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a href="/Home/OrderEdit/@item.OrderID" class="btn btn-outline-warning btn-sm me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="OrderDelete" asp-controller="Home" asp-route-id="@item.OrderID" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Silmek istediğine emin misin?');">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
