@model IEnumerable<WarehouseManagementSystem.Models.Category>
@{
    ViewData["Title"] = "Kategoriler";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-tags text-secondary"></i> Kategoriler
    </h2>
    <a href="/Home/CategoryCreate" class="btn btn-primary rounded-pill shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Yeni Kategori
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-warning text-center">
        <i class="bi bi-exclamation-circle"></i> Henüz kategori eklenmemiş!
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card shadow-sm hover-shadow h-100 border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-tags display-4 text-secondary mb-2"></i>
                        <h5 class="card-title">@item.CategoryName</h5>
                        <a href="/Home/CategoryEdit/@item.CategoryID" class="btn btn-outline-info btn-sm me-1">
                            <i class="bi bi-pencil"></i> Düzenle
                        </a>
                        <a href="/Home/CategoryDelete/@item.CategoryID" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-trash"></i> Sil
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
