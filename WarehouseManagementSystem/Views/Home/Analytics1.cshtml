@{
    ViewData["Title"] = "Analitik Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h2 class="fw-bold my-4 text-center">
        <i class="bi bi-bar-chart-line text-primary"></i> Analitik Raporlar & Grafikler
    </h2>
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white fw-semibold">
                    <i class="bi bi-graph-up"></i> En Çok Satılan Ürünler
                </div>
                <div class="card-body">
                    <canvas id="topProductsChart" height="220"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white fw-semibold">
                    <i class="bi bi-pie-chart"></i> Stok Dağılımı
                </div>
                <div class="card-body">
                    <canvas id="stockChart" height="220"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-12">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-warning text-dark fw-semibold">
                    <i class="bi bi-calendar3"></i> Aylık Satışlar
                </div>
                <div class="card-body">
                    <canvas id="monthlySalesChart" height="100"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // En Çok Satılan Ürünler
        fetch('/Home/GetTopProductsData')
            .then(res => res.json())
            .then(data => {
                const labels = data.map(x => x.productName);
                const quantities = data.map(x => x.totalSold);
                new Chart(document.getElementById('topProductsChart'), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Satış Adedi',
                            data: quantities,
                            backgroundColor: 'rgba(54, 162, 235, 0.6)'
                        }]
                    },
                    options: { responsive: true, scales: { y: { beginAtZero: true } } }
                });
            });

        // Stok Dağılımı (Pie)
        fetch('/Home/GetStockDistributionData')
            .then(res => res.json())
            .then(data => {
                const labels = data.map(x => x.productName);
                const stocks = data.map(x => x.quantityInStock);
                new Chart(document.getElementById('stockChart'), {
                    type: 'pie',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: stocks,
                            backgroundColor: [
                                'rgba(255, 99, 132, 0.5)',
                                'rgba(54, 162, 235, 0.5)',
                                'rgba(255, 206, 86, 0.5)',
                                'rgba(75, 192, 192, 0.5)',
                                'rgba(153, 102, 255, 0.5)',
                                'rgba(255, 159, 64, 0.5)',
                                // Daha fazla renk gerekiyorsa ekle
                            ]
                        }]
                    },
                    options: { responsive: true }
                });
            });

        // Aylık Satışlar (Line)
        fetch('/Home/GetMonthlySalesData')
            .then(res => res.json())
            .then(data => {
                const labels = data.map(x => x.month);
                const amounts = data.map(x => x.totalAmount);
                new Chart(document.getElementById('monthlySalesChart'), {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Toplam Satış (₺)',
                            data: amounts,
                            borderColor: 'rgba(255, 99, 132, 1)',
                            backgroundColor: 'rgba(255, 99, 132, 0.1)',
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: { responsive: true, scales: { y: { beginAtZero: true } } }
                });
            });
    </script>
}
