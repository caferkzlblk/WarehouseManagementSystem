@model IEnumerable<WarehouseManagementSystem.Models.Users>
@{
    ViewData["Title"] = "Kullanıcılar";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-person text-info"></i> Kullanıcılar
    </h2>
    <a href="/Home/UserCreate" class="btn btn-primary rounded-pill shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Yeni Kullanıcı
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-warning text-center">
        <i class="bi bi-exclamation-circle"></i> Henüz kullanıcı eklenmemiş!
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm rounded">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Kullanıcı Adı</th>
                    <th>Rol</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><i class="bi bi-person text-info"></i></td>
                        <td>@item.UserName</td>
                        <td>@item.RoleID</td>
                        <td>
                            <a href="/Home/UserEdit/@item.UserID" class="btn btn-outline-info btn-sm me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a href="/Home/UserDelete/@item.UserID" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
