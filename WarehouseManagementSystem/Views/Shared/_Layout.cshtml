@inject IHttpContextAccessor Accessor
@{
    var lowStockProducts = ViewBag.LowStockProducts as List<WarehouseManagementSystem.Models.Product>;
    var userName = ViewBag.UserName as string ?? "Kullanıcı";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Warehouse MS</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            background: #f8fafb;
        }

        .navbar {
            box-shadow: 0 2px 8px 0 #eee;
        }

        .card {
            border-radius: 1.2rem;
        }

        .toast {
            min-width: 300px;
        }

        .profile-badge {
            background: #e9ecef;
            border-radius: 100px;
            padding: 4px 14px;
            margin-left: 12px;
            font-size: .95em;
        }
        /* KART HOVER EFEKTI */
        .hover-shadow {
            transition: transform 0.25s cubic-bezier(.4,2,.6,1), box-shadow 0.22s;
        }

            .hover-shadow:hover {
                transform: scale(1.055) translateY(-4px);
                box-shadow: 0 8px 24px rgba(33,60,118,0.10), 0 1.5px 4px rgba(33,60,118,0.09);
                z-index: 2;
            }
    </style>
</head>
<body>
    <!-- Toast Uyarıları -->
    @if (lowStockProducts != null && lowStockProducts.Any())
    {
        <div id="toastContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 1050">
            @foreach (var product in lowStockProducts)
            {
                <div class="toast align-items-center text-bg-warning border-0 mb-2 show" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>@product.ProductName</strong> ürünü için stok seviyesi düşük. Mevcut stok: <b>@product.QuantityInStock</b>
                        </div>
                        <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            }
        </div>
        <script>
            window.onload = function () {
                var toastElList = [].slice.call(document.querySelectorAll('.toast'));
                toastElList.map(function (toastEl) {
                    var t = new bootstrap.Toast(toastEl);
                    t.show();
                });
            }
        </script>
    }

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/Home/Index">
                <i class="bi bi-box-seam me-2 text-primary" style="font-size: 2rem;"></i>Warehouse MS
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" href="/Home/Orders"><i class="bi bi-basket"></i> Siparişler</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/Products"><i class="bi bi-box"></i> Ürünler</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/Suppliers"><i class="bi bi-truck"></i> Tedarikçiler</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/Categories"><i class="bi bi-tags"></i> Kategoriler</a></li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Analytics1"><i class="bi bi-bar-chart"></i> Analitik</a>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="/Home/Users"><i class="bi bi-person"></i> Kullanıcılar</a></li>
                </ul>
                <div class="d-flex align-items-center">
                    <span class="profile-badge">
                        <i class="bi bi-person-circle me-1"></i>
                        @ViewBag.UserName
                    </span>
                    <a href="/Account/Logout" class="btn btn-outline-secondary btn-sm ms-2">Çıkış</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container mb-4" style="min-height: 60vh;">
        @RenderBody()
    </main>

    <footer class="bg-white border-top py-3 text-center small text-muted">
        <span>&copy; @DateTime.Now.Year | <b>Warehouse Management System</b></span>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
